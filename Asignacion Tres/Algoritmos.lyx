\begin_layout Plain Layout

import heapq
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

def dijkstra_optimizado(grafo,
 origen):
\end_layout

\begin_layout Plain Layout

    # 1.
 Inicializacion
\end_layout

\begin_layout Plain Layout

    # Asignamos infinito a todos los nodos,
 excepto al origen que es 0
\end_layout

\begin_layout Plain Layout

    distancias = {nodo:
 float('inf') for nodo in grafo}
\end_layout

\begin_layout Plain Layout

    distancias[origen] = 0
\end_layout

\begin_layout Plain Layout

    
\end_layout

\begin_layout Plain Layout

    # Diccionario para reconstruir la ruta final
\end_layout

\begin_layout Plain Layout

    predecesores = {nodo:
 None for nodo in grafo}
\end_layout

\begin_layout Plain Layout

    
\end_layout

\begin_layout Plain Layout

    # Cola de prioridad (Min-Heap).
 Almacena tuplas:
 (distancia_acumulada,
 nodo)
\end_layout

\begin_layout Plain Layout

    cola_prioridad = [(0,
 origen)]
\end_layout

\begin_layout Plain Layout

    
\end_layout

\begin_layout Plain Layout

    while cola_prioridad:
\end_layout

\begin_layout Plain Layout

        # 2.
 Extraccion del Minimo (O(log V))
\end_layout

\begin_layout Plain Layout

        distancia_actual,
 nodo_actual = heapq.heappop(cola_prioridad)
\end_layout

\begin_layout Plain Layout

        
\end_layout

\begin_layout Plain Layout

        # Si extraemos una ruta obsoleta que ya fue mejorada,
 la ignoramos
\end_layout

\begin_layout Plain Layout

        if distancia_actual > distancias[nodo_actual]:
\end_layout

\begin_layout Plain Layout

            continue
\end_layout

\begin_layout Plain Layout

            
\end_layout

\begin_layout Plain Layout

        # 3.
 Fase de Relajacion
\end_layout

\begin_layout Plain Layout

        for vecino,
 peso_arista in grafo[nodo_actual].items():
\end_layout

\begin_layout Plain Layout

            distancia_calculada = distancia_actual + peso_arista
\end_layout

\begin_layout Plain Layout

            
\end_layout

\begin_layout Plain Layout

            # Condicion:
 si d(v) > d(u) + w(u,
 v) => d(v) = d(u) + w(u,
 v)
\end_layout

\begin_layout Plain Layout

            if distancia_calculada < distancias[vecino]:
\end_layout

\begin_layout Plain Layout

                distancias[vecino] = distancia_calculada
\end_layout

\begin_layout Plain Layout

                predecesores[vecino] = nodo_actual
\end_layout

\begin_layout Plain Layout

                
\end_layout

\begin_layout Plain Layout

                # Actualizamos la cola de prioridad con la nueva mejor distancia
\end_layout

\begin_layout Plain Layout

                heapq.heappush(cola_prioridad,
 (distancia_calculada,
 vecino))
\end_layout

\begin_layout Plain Layout

                
\end_layout

\begin_layout Plain Layout

    return distancias,
 predecesores
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

def reconstruir_ruta(predecesores,
 origen,
 destino):
\end_layout

\begin_layout Plain Layout

    ruta = []
\end_layout

\begin_layout Plain Layout

    nodo_actual = destino
\end_layout

\begin_layout Plain Layout

    while nodo_actual is not None:
\end_layout

\begin_layout Plain Layout

        ruta.insert(0,
 nodo_actual)
\end_layout

\begin_layout Plain Layout

        nodo_actual = predecesores[nodo_actual]
\end_layout

\begin_layout Plain Layout

    return ruta if ruta[0] == origen else []
\end_layout

