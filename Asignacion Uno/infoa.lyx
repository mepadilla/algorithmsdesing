\begin_layout Plain Layout

def ordenamiento_burbuja(lista):
\end_layout

\begin_layout Plain Layout

    n = len(lista)
\end_layout

\begin_layout Plain Layout

    for i in range(n):
\end_layout

\begin_layout Plain Layout

        for j in range(0,
 n - i - 1):
\end_layout

\begin_layout Plain Layout

            if lista[j] > lista[j + 1]:
\end_layout

\begin_layout Plain Layout

                lista[j],
 lista[j + 1] = lista[j + 1],
 lista[j]
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

def ordenamiento_seleccion(lista):
\end_layout

\begin_layout Plain Layout

    n = len(lista)
\end_layout

\begin_layout Plain Layout

    for i in range(n):
\end_layout

\begin_layout Plain Layout

        min_idx = i
\end_layout

\begin_layout Plain Layout

        for j in range(i + 1,
 n):
\end_layout

\begin_layout Plain Layout

            if lista[min_idx] > lista[j]:
\end_layout

\begin_layout Plain Layout

                min_idx = j
\end_layout

\begin_layout Plain Layout

        lista[i],
 lista[min_idx] = lista[min_idx],
 lista[i]
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

def quicksort(lista):
\end_layout

\begin_layout Plain Layout

    if len(lista) <= 1:
\end_layout

\begin_layout Plain Layout

        return lista
\end_layout

\begin_layout Plain Layout

    pivote = lista[len(lista) // 2]
\end_layout

\begin_layout Plain Layout

    izq = [x for x in lista if x < pivote]
\end_layout

\begin_layout Plain Layout

    centro = [x for x in lista if x == pivote]
\end_layout

\begin_layout Plain Layout

    der = [x for x in lista if x > pivote]
\end_layout

\begin_layout Plain Layout

    return quicksort(izq) + centro + quicksort(der)
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# ==========================================
\end_layout

\begin_layout Plain Layout

# 3.
 LÓGICA DE ESTIMACIÓN BIG O
\end_layout

\begin_layout Plain Layout

# ==========================================
\end_layout

\begin_layout Plain Layout

def func_lineal(n,
 a,
 b):
 return a * n + b
\end_layout

\begin_layout Plain Layout

def func_cuadratica(n,
 a,
 b):
 return a * (n**2) + b
\end_layout

\begin_layout Plain Layout

def func_logaritmica(n,
 a,
 b):
 return a * np.log2(n + 1) + b
\end_layout

\begin_layout Plain Layout

def func_nlogn(n,
 a,
 b):
 return a * n * np.log2(n + 1) + b
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

def estimar_big_o(n_vals,
 t_vals,
 tipo="busqueda"):
\end_layout

\begin_layout Plain Layout

    n_pts = np.array(n_vals)
\end_layout

\begin_layout Plain Layout

    t_pts = np.array(t_vals)
\end_layout

\begin_layout Plain Layout

    try:
\end_layout

\begin_layout Plain Layout

        popt_lin,
 _ = curve_fit(func_lineal,
 n_pts,
 t_pts)
\end_layout

\begin_layout Plain Layout

        err_lin = np.sum((func_lineal(n_pts,
 *popt_lin) - t_pts)**2)
\end_layout

\begin_layout Plain Layout

        
\end_layout

\begin_layout Plain Layout

        if tipo == "busqueda":
\end_layout

\begin_layout Plain Layout

            popt_log,
 _ = curve_fit(func_logaritmica,
 n_pts,
 t_pts)
\end_layout

\begin_layout Plain Layout

            err_log = np.sum((func_logaritmica(n_pts,
 *popt_log) - t_pts)**2)
\end_layout

\begin_layout Plain Layout

            return "O(log n)" if err_log < err_lin else "O(n)"
\end_layout

\begin_layout Plain Layout

        elif tipo == "lento":
\end_layout

\begin_layout Plain Layout

            popt_cua,
 _ = curve_fit(func_cuadratica,
 n_pts,
 t_pts)
\end_layout

\begin_layout Plain Layout

            err_cua = np.sum((func_cuadratica(n_pts,
 *popt_cua) - t_pts)**2)
\end_layout

\begin_layout Plain Layout

            return "O(n^2)" if err_cua < err_lin else "O(n)"
\end_layout

\begin_layout Plain Layout

        else:
 # rapido
\end_layout

\begin_layout Plain Layout

            popt_nlogn,
 _ = curve_fit(func_nlogn,
 n_pts,
 t_pts)
\end_layout

\begin_layout Plain Layout

            err_nlogn = np.sum((func_nlogn(n_pts,
 *popt_nlogn) - t_pts)**2)
\end_layout

\begin_layout Plain Layout

            return "O(n log n)" if err_nlogn < err_lin else "O(n)"
\end_layout

\begin_layout Plain Layout

    except:
\end_layout

\begin_layout Plain Layout

        return "Indeterminado"
\end_layout

