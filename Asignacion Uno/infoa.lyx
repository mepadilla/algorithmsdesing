\begin_layout Plain Layout

def busqueda_lineal(lista,
 objetivo):
\end_layout

\begin_layout Plain Layout

    for i in range(len(lista)):
\end_layout

\begin_layout Plain Layout

        if lista[i] == objetivo:
\end_layout

\begin_layout Plain Layout

            return i
\end_layout

\begin_layout Plain Layout

    return -1
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

def busqueda_binaria(lista,
 objetivo):
\end_layout

\begin_layout Plain Layout

    bajo,
 alto = 0,
 len(lista) - 1
\end_layout

\begin_layout Plain Layout

    while bajo <= alto:
\end_layout

\begin_layout Plain Layout

        medio = (bajo + alto) // 2
\end_layout

\begin_layout Plain Layout

        if lista[medio] == objetivo:
\end_layout

\begin_layout Plain Layout

            return medio
\end_layout

\begin_layout Plain Layout

        elif lista[medio] < objetivo:
\end_layout

\begin_layout Plain Layout

            bajo = medio + 1
\end_layout

\begin_layout Plain Layout

        else:
\end_layout

\begin_layout Plain Layout

            alto = medio - 1
\end_layout

\begin_layout Plain Layout

    return -1
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

# ==========================================
\end_layout

